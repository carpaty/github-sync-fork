{
  "name": "github-sync-fork",
  "displayName": "GitHub Sync Fork",
  "description": "VS Code extension to sync your code from upstream in GitHub",
  "icon": "images/icon.png",
  "publisher": "aspel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carpaty/github-sync-fork.git"
  },
  "version": "0.0.15",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "github-sync-fork.upstream",
        "category": "GitHub Sync Fork",
        "title": "Sync branch at GitHub from Upstream branch",
        "shortTitle": "Sync Fork at GitHub from Upstream",
        "icon": "$(repo-forked)"
      },
      {
        "command": "github-sync-fork.createBranch",
        "category": "GitHub Sync Fork",
        "title": "Create GitHub branch linked to upstream",
        "shortTitle": "Create GitHub Branch",
        "icon": "$(git-merge)"
      }

    ],
    "menus": {
      "scm/title": [
        {
          "command": "github-sync-fork.upstream",
          "group": "navigation",
          "when": "scmProvider == git && github.hasGitHubRepo"
        }
      ],
      "scm/repository": [
        {
          "command": "github-sync-fork.upstream",
          "group": "inline",
          "when": "scmProvider == git && github.hasGitHubRepo && scmProviderContext == repository"
        }
      ],
      "commandPalette": [
        {
          "command": "github-sync-fork.upstream",
          "when": "github.hasGitHubRepo"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch --mode development",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@octokit/types": "13.5.0",
    "@types/vscode": "^1.106.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "ts-loader": "^9.5.1",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  },
  "dependencies": {
    "@octokit/rest": "^18.0.0"
  }
}
