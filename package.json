{
  "name": "github-sync-fork",
  "displayName": "GitHub Sync Fork",
  "description": "VS Code extension to sync your code from upstream in GitHub",
  "icon": "images/icon.png",
  "publisher": "aspel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carpaty/github-sync-fork.git"
  },
  "version": "0.0.21",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "github-sync-fork.syncBranch",
        "category": "GitHub Sync Fork",
        "title": "Sync branch at GitHub from Upstream branch",
        "shortTitle": "Sync Fork at GitHub from Upstream",
        "icon": "$(repo-forked)"
      },
      {
        "command": "github-sync-fork.createBranch",
        "category": "GitHub Sync Fork",
        "title": "Create GitHub branch linked to upstream",
        "shortTitle": "Create GitHub Branch",
        "icon": "$(git-merge)"
      }
    ],
    "configuration": {
      "title": "GitHub Sync Fork",
      "properties": {
        "github-sync-fork.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging to the 'GitHub Sync Fork' output channel."
        },
        "github-sync-fork.autoSyncOnPull": {
          "type": "string",
          "enum": [
            "off",
            "prompt",
            "always"
          ],
          "default": "off",
          "description": "Automatically sync the current fork branch after repository updates (such as pull/fetch) when it is behind upstream. In 'prompt' mode, pause timing can also include prompt rate-limit windows."
        },
        "github-sync-fork.autoSyncBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master"
          ],
          "description": "Branch patterns eligible for auto-sync (supports '*' and '?'). Prefix with '!' to exclude branches (for example '!release/*')."
        },
        "github-sync-fork.autoSyncCooldownMinutes": {
          "type": "number",
          "minimum": 0,
          "default": 30,
          "description": "Minimum minutes between auto-sync actions/prompts for the same repository branch. The status bar 'auto-sync paused' time is calculated from cooldown plus any active snooze/rate-limit windows."
        }
      }
    },
    "menus": {
      "scm/title": [
        {
          "command": "github-sync-fork.syncBranch",
          "group": "navigation",
          "when": "scmProvider == git && github.hasGitHubRepo"
        }
      ],
      "scm/repository": [
        {
          "command": "github-sync-fork.syncBranch",
          "group": "inline",
          "when": "scmProvider == git && github.hasGitHubRepo && scmProviderContext == repository"
        }
      ],
      "commandPalette": [
        {
          "command": "github-sync-fork.syncBranch"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch --mode development",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@octokit/types": "13.5.0",
    "@types/vscode": "^1.106.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "ts-loader": "^9.5.1",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  },
  "dependencies": {
    "@octokit/rest": "^18.0.0"
  }
}
